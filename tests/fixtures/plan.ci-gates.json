{
  "schemaVersion": "1.0.0",
  "target": "main",
  "items": [
    {
      "name": "ci-lint",
      "deps": [],
      "gates": [
        {
          "name": "lint",
          "run": "npm run lint"
        }
      ]
    },
    {
      "name": "ci-typecheck",
      "deps": [],
      "gates": [
        {
          "name": "typecheck",
          "run": "npm run typecheck"
        }
