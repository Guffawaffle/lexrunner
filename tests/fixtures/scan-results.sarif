{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "test-scanner",
          "version": "1.0.0"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-1234",
          "level": "error",
          "message": {
            "text": "Critical SQL injection vulnerability"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-a"
                }
              }
            }
          ],
          "properties": {
            "security-severity": "critical",
            "package": "package-a",
            "version": "1.0.0",
            "cve": "CVE-2024-1234",
            "cvss": 9.8
          }
        },
        {
          "ruleId": "CVE-2024-5678",
          "level": "error",
          "message": {
            "text": "High severity XSS vulnerability"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-b"
                }
              }
            }
          ],
          "properties": {
            "security-severity": "high",
            "package": "package-b",
            "version": "2.0.0",
            "cve": "CVE-2024-5678",
            "cvss": 7.5
          }
        },
        {
          "ruleId": "GHSA-abcd",
          "level": "warning",
          "message": {
            "text": "Medium severity authentication bypass"
          },
          "properties": {
            "security-severity": "medium",
            "package": "package-c",
            "version": "3.0.0"
          }
        }
      ]
    }
  ]
}
