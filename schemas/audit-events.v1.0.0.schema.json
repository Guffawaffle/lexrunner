{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartergpt.dev/schemas/audit-events/v1.0.0.json",
  "title": "lexrunner Audit Events",
  "description": "Schema for audit event logging with versioning and backward compatibility",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "event",
    "ts",
    "session_id",
    "run_id",
    "tool",
    "actor",
    "repo",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the audit event schema (MAJOR.MINOR.PATCH)",
      "examples": ["1.0.0", "1.1.0", "2.0.0"]
    },
    "event": {
      "type": "string",
      "enum": [
        "command_invocation",
        "plan_discovered",
        "plan_validated",
        "merge_order_computed",
        "gate_started",
        "gate_finished",
        "merge_dry_run_started",
        "merge_dry_run_finished",
        "merge_execute_started",
        "merge_conflict_detected",
        "merge_finished",
        "artifact_written",
        "error",
        "run_summary"
      ],
      "description": "Type of audit event"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the event occurred"
    },
    "level": {
      "type": "string",
      "enum": ["info", "warn", "error"],
      "default": "info",
      "description": "Severity level of the event"
    },
    "session_id": {
      "type": "string",
      "description": "Unique identifier for the user session"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this specific run/execution"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the tool (e.g., 'lexrunner')"
        },
        "version": {
          "type": "string",
          "description": "Version of the tool",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"
        }
      },
      "description": "Information about the tool that emitted this event"
    },
    "actor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cli", "mcp", "ci"],
          "description": "Type of actor that initiated the action"
        },
        "user": {
          "type": "string",
          "description": "Optional user identifier"
        }
      },
      "description": "Information about who/what initiated this event"
    },
    "repo": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "description": "Git remote URL"
        },
        "branch": {
          "type": "string",
          "description": "Current branch name"
        },
        "commit": {
          "type": "string",
          "description": "Current commit SHA"
        }
      },
      "description": "Repository context information"
    },
    "context": {
      "type": "object",
      "properties": {
        "git": {
          "type": "object",
          "description": "Git-specific context"
        },
        "ci": {
          "type": "object",
          "description": "CI/CD environment context"
        },
        "os": {
          "type": "object",
          "description": "Operating system context"
        }
      },
      "description": "Additional context information"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific payload (varies by event type)"
    }
  }
}
