{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/executor-manifest.schema.json",
  "title": "Executor Manifest Schema v1.0.0",
  "description": "Schema for executor-manifest.yaml files - generated from Zod schema in src/schemas/executorManifest.ts. Based on v0.3.0 thesis: Section 3.3 (Executors as Operational Units)",
  "$ref": "#/definitions/ExecutorManifest",
  "definitions": {
    "ExecutorManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^executor-\\d+\\.\\d+\\.\\d+$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "toolBudget": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "denied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "limits": {
              "type": "object",
              "properties": {
                "maxToolCalls": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxTokensOut": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "guardrails": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "properties": {
                "allowedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "deniedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              },
              "additionalProperties": false
            },
            "tool": {
              "type": "object",
              "properties": {
                "required": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "optional": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              },
              "additionalProperties": false
            },
            "epistemic": {
              "type": "object",
              "properties": {
                "allowIDK": {
                  "type": "boolean",
                  "default": true
                },
                "escalationThreshold": {
                  "type": "string",
                  "enum": [
                    "low-risk",
                    "medium-risk",
                    "high-risk",
                    "critical"
                  ]
                }
              },
              "additionalProperties": false
            },
            "style": {
              "type": "object",
              "properties": {
                "requirePlan": {
                  "type": "boolean",
                  "default": false
                },
                "requireSummary": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            },
            "audit": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "minimal",
                    "normal",
                    "verbose",
                    "debug"
                  ],
                  "default": "normal"
                },
                "frameSchema": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "jordanModeProtocol": {
          "type": "object",
          "properties": {
            "prepPhase": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "stochasticPhase": {
              "type": "object",
              "properties": {
                "promptTemplate": {
                  "type": "string"
                },
                "maxCalls": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                }
              },
              "required": [
                "promptTemplate"
              ],
              "additionalProperties": false
            },
            "receiptPhase": {
              "type": "object",
              "properties": {
                "frameType": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "frameType",
                "fields"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "stochasticPhase",
            "receiptPhase"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "role",
        "toolBudget",
        "jordanModeProtocol"
      ],
      "additionalProperties": false
    }
  }
}