{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Guffawaffle/lex-pr-runner/schemas/gates/build.schema.json",
  "title": "Build Gate Input Schema",
  "description": "Input contract for build gate execution",
  "type": "object",
  "required": ["command"],
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "Build command to execute"
    },
    "outputDir": {
      "type": "string",
      "description": "Output directory for build artifacts"
    },
    "clean": {
      "type": "boolean",
      "default": false,
      "description": "Clean before build"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Build targets to execute"
    }
  },
  "additionalProperties": false
}
