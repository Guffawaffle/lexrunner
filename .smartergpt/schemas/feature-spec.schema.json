{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://github.com/Guffawaffle/LexRunner/schemas/feature-spec.schema.json",
	"title": "Feature Spec Schema v1",
	"description": "Feature specification generated from captured ideas",
	"type": "object",
	"required": [
		"problem",
		"goals",
		"nonGoals",
		"acceptanceCriteria",
		"artifacts"
	],
	"properties": {
		"problem": {
			"type": "string",
			"minLength": 10,
			"description": "Clear statement of the problem being solved"
		},
		"goals": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 5
			},
			"description": "What this feature will accomplish"
		},
		"nonGoals": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 5
			},
			"description": "Explicitly out of scope for this feature"
		},
		"acceptanceCriteria": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 5
			},
			"description": "Testable criteria for feature completion"
		},
		"risks": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 5
			},
			"description": "Known risks and mitigation strategies"
		},
		"artifacts": {
			"type": "object",
			"required": ["docs", "code", "gates"],
			"properties": {
				"docs": {
					"type": "array",
					"items": {
						"type": "string",
						"description": "Documentation files to be created or updated"
					},
					"description": "Documentation deliverables"
				},
				"code": {
					"type": "array",
					"items": {
						"type": "string",
						"description": "Code modules or files to be implemented"
					},
					"description": "Code deliverables"
				},
				"gates": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"lint",
							"typecheck",
							"test",
							"e2e",
							"build",
							"determinism",
							"security"
						]
					},
					"description": "Required gates for this feature"
				}
			}
		},
		"dependencies": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["type", "name"],
				"properties": {
					"type": {
						"type": "string",
						"enum": ["issue", "pr", "epic", "external"]
					},
					"name": {
						"type": "string",
						"description": "Name or URL of the dependency"
					},
					"status": {
						"type": "string",
						"enum": [
							"pending",
							"in-progress",
							"blocked",
							"completed"
						]
					}
				}
			},
			"description": "Dependencies that must be satisfied"
		},
		"estimatedComplexity": {
			"type": "string",
			"enum": ["XS", "S", "M", "L", "XL"],
			"description": "Rough complexity estimate"
		},
		"priority": {
			"type": "string",
			"enum": ["P0", "P1", "P2", "P3"],
			"description": "Priority level"
		}
	}
}
