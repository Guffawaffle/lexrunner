{
	"name": "lex-pr-runner",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20 <23"
	},
	"packageManager": "npm@10.0.0",
	"auditSchemaVersion": "1.0.0",
	"bin": {
		"lex-pr": "dist/cli.js",
		"lex-pr-runner-mcp": "./mcp-server.mjs"
	},
	"types": "dist/cli.d.ts",
	"exports": {
		".": {
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js",
			"require": "./dist/cli.cjs"
		},
		"./audit-sdk": {
			"types": "./dist/sdk/index.d.ts",
			"import": "./dist/sdk/index.js"
		},
		"./schemas/runner-stack": {
			"types": "./.smartergpt/schemas/runner.stack.schema.d.ts",
			"import": "./.smartergpt/schemas/runner.stack.schema.js"
		},
		"./schemas/runner-scope": {
			"types": "./.smartergpt/schemas/runner.scope.schema.d.ts",
			"import": "./.smartergpt/schemas/runner.scope.schema.js"
		},
		"./schemas/execution-plan-v1": {
			"types": "./.smartergpt/schemas/execution-plan-v1.d.ts",
			"import": "./.smartergpt/schemas/execution-plan-v1.js"
		},
		"./schemas/gates": {
			"types": "./.smartergpt/schemas/gates.schema.d.ts",
			"import": "./.smartergpt/schemas/gates.schema.js"
		}
	},
	"scripts": {
		"postinstall": "node -e \"console.log('\\n📦 lex-pr-runner installed! Run \\\"npx lex-pr init\\\" to set up your workspace.\\n')\"",
		"dev": "tsx watch src/cli.ts",
		"cli": "tsx src/cli.ts",
		"cli:built": "node dist/cli.js",
		"mcp": "node mcp-server.mjs",
		"build": "tsup src/cli.ts --format esm,cjs --dts --out-dir dist",
		"pretest": "npm run build",
		"generate:schemas": "tsx scripts/generate-plan-schema.ts && tsx scripts/generate-gate-schema.ts && tsx scripts/generate-flake-schema.ts",
		"lint": "echo 'Lint: TypeScript compilation handles most issues' && npm run typecheck",
		"format": "echo 'Format: using editorconfig for consistent formatting'",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"release:prepare": "tsx scripts/release-prepare.ts",
		"generate:mcp-servers": "python3 scripts/gen_mcp_servers.py -r /srv -r /home/guff --recursive -o servers.json --workspace-out servers.workspace.json",
		"generate:mcp-servers:dry": "python3 scripts/gen_mcp_servers.py --dry-run --recursive -r /srv -r /home/guff",
		"ci:debug": "bash scripts/ci-debug.sh",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@babel/parser": "^7.28.4",
		"@babel/traverse": "^7.28.4",
		"@modelcontextprotocol/sdk": "^1.18.2",
		"@octokit/auth-token": "^6.0.0",
		"@octokit/rest": "^22.0.0",
		"@smartergpt/lex": "^0.4.6-alpha",
		"@types/babel__traverse": "^7.28.0",
		"chalk": "^5.3.0",
		"commander": "^12.0.0",
		"execa": "^9.2.0",
		"fs-extra": "^11.2.0",
		"simple-git": "^3.24.0",
		"ulid": "^3.0.1",
		"yaml": "^2.6.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^20.12.12",
		"eslint": "^9.10.0",
		"tsup": "^8.1.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.3",
		"vitest": "^2.0.0"
	}
}
